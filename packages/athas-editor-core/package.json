{
  "name": "@athas/editor-core",
  "version": "0.0.0",
  "description": "Framework-independent editor primitives, types, and text utilities from Athas.",
  "files": [
    "README.md",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./types": "./src/types.ts",
    "./utils/*": "./src/utils/*.ts",
    "./view-model/*": "./src/view-model/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
