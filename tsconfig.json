{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@athas/editor": ["./packages/athas-editor/src/index.ts"],
      "@athas/editor/*": ["./packages/athas-editor/src/*"],
      "@athas/editor-core": ["./packages/athas-editor-core/src/index.ts"],
      "@athas/editor-core/*": ["./packages/athas-editor-core/src/*"]
    }
  },
  "include": ["src", "packages/*/src"],
  "exclude": ["**/*.stories.tsx", "**/*.stories.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
